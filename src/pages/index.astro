---
import Base from '../layouts/Base.astro';
import { marca, mensagemWhatsapp, sistemas, numeros, passos, beneficiosParceiro, faixa } from '../data/site';

const zap = `https://wa.me/${marca.whatsapp}?text=${encodeURIComponent(mensagemWhatsapp)}`;
const zapParceiro = `https://wa.me/${marca.whatsapp}?text=${encodeURIComponent('Olá! Quero ser parceiro de indicação da Órbita Soft.')}`;
const ano = new Date().getFullYear();

const icones: Record<string, string> = {
  cardapio: 'M4 5h16M4 12h16M4 19h10',
  chat: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z',
  grafica: 'M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M7 14h10v7H7z',
};
---

<Base>
  <!-- NAVEGAÇÃO -->
  <header id="topo" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
      <a href="#inicio" class="flex items-center gap-2.5" aria-label="Órbita Soft, início">
        <img src="/favicon.svg" alt="" width="36" height="36" class="h-9 w-9" />
        <span class="font-display text-xl font-semibold tracking-tight">Órbita <span class="text-white/60">Soft</span></span>
      </a>
      <ul class="hidden items-center gap-8 text-sm text-white/70 md:flex">
        <li><a class="transition hover:text-white" href="#sistemas">Sistemas</a></li>
        <li><a class="transition hover:text-white" href="#como-funciona">Como funciona</a></li>
        <li><a class="transition hover:text-white" href="#parceiros">Parceiros</a></li>
        <li><a class="transition hover:text-white" href="#contato">Contato</a></li>
      </ul>
      <a href={zap} target="_blank" rel="noopener" class="botao botao-principal hidden !py-2.5 text-sm md:inline-flex">Falar no WhatsApp</a>
      <button id="menu-btn" class="grid h-11 w-11 place-items-center rounded-full border border-white/15 md:hidden" aria-label="Abrir menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </nav>
    <div id="menu-mobile" class="hidden border-t border-white/10 bg-[#05060f]/95 px-5 pb-6 pt-2 backdrop-blur md:hidden">
      <a class="block py-3 text-white/80" href="#sistemas">Sistemas</a>
      <a class="block py-3 text-white/80" href="#como-funciona">Como funciona</a>
      <a class="block py-3 text-white/80" href="#parceiros">Parceiros</a>
      <a class="block py-3 text-white/80" href="#contato">Contato</a>
      <a href={zap} target="_blank" rel="noopener" class="botao botao-principal mt-3 w-full">Falar no WhatsApp</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section id="inicio" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24">
      <canvas id="orbitas" class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
      <div class="malha absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="absolute -left-40 top-20 -z-10 h-[34rem] w-[34rem] rounded-full bg-blue-600/25 blur-[140px]" aria-hidden="true"></div>
      <div class="absolute -right-40 bottom-0 -z-10 h-[30rem] w-[30rem] rounded-full bg-violet-600/25 blur-[140px]" aria-hidden="true"></div>

      <div class="mx-auto grid w-full max-w-7xl items-center gap-14 px-5 py-16 sm:px-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="revelar mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/70">
            <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
            Sistemas no ar, prontos para o seu negócio
          </p>
          <h1 class="revelar font-display text-5xl font-bold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl" style="--atraso:80ms">
            Sistemas que colocam o seu negócio <span class="texto-gradiente">em órbita.</span>
          </h1>
          <p class="revelar mt-7 max-w-xl text-lg leading-relaxed text-white/65" style="--atraso:160ms">
            Gestão, vendas, atendimento e cobrança em plataformas modernas, feitas no Brasil. Conheça nossos sistemas e
            cresça com quem entende do seu dia a dia.
          </p>
          <div class="revelar mt-10 flex flex-wrap gap-4" style="--atraso:240ms">
            <a href="#sistemas" class="botao botao-principal">Ver os sistemas
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href={zap} target="_blank" rel="noopener" class="botao botao-vidro">Falar no WhatsApp</a>
          </div>
        </div>

        <!-- Mockup flutuante -->
        <div class="revelar relative mx-auto w-full max-w-md" style="--atraso:200ms">
          <div id="tilt" class="flutuar relative" style="transform-style:preserve-3d">
            <div class="rounded-3xl border border-white/15 bg-gradient-to-br from-white/10 to-white/[0.02] p-5 shadow-2xl shadow-blue-900/40 backdrop-blur-xl">
              <div class="mb-4 flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-rose-400/80"></span><span class="h-3 w-3 rounded-full bg-amber-300/80"></span><span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
                <span class="ml-3 text-xs text-white/40">painel.enki</span>
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-2xl bg-white/5 p-3"><p class="text-[10px] uppercase tracking-wider text-white/40">Vendas hoje</p><p class="font-display text-xl font-semibold">R$ 8,4k</p></div>
                <div class="rounded-2xl bg-white/5 p-3"><p class="text-[10px] uppercase tracking-wider text-white/40">Pedidos</p><p class="font-display text-xl font-semibold">127</p></div>
                <div class="rounded-2xl bg-white/5 p-3"><p class="text-[10px] uppercase tracking-wider text-white/40">Ticket</p><p class="font-display text-xl font-semibold">R$ 66</p></div>
              </div>
              <div class="mt-3 rounded-2xl bg-white/5 p-4">
                <svg viewBox="0 0 300 100" class="h-24 w-full" preserveAspectRatio="none" aria-hidden="true">
                  <defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#60a5fa" stop-opacity=".5"/><stop offset="1" stop-color="#60a5fa" stop-opacity="0"/></linearGradient></defs>
                  <path d="M0 80 C30 70 50 90 80 60 S130 40 160 50 S220 20 250 30 S290 10 300 8 V100 H0Z" fill="url(#area)"></path>
                  <path d="M0 80 C30 70 50 90 80 60 S130 40 160 50 S220 20 250 30 S290 10 300 8" fill="none" stroke="#67e8f9" stroke-width="2.5"></path>
                </svg>
              </div>
              <div class="mt-3 flex items-center justify-between rounded-2xl bg-emerald-400/10 px-4 py-3 text-sm">
                <span class="text-emerald-300">Pix recebido</span><span class="font-semibold">+ R$ 189,90</span>
              </div>
            </div>
            <div class="absolute -right-6 -top-6 rounded-2xl border border-white/15 bg-[#0b0d1c]/90 px-4 py-3 text-sm shadow-xl backdrop-blur" style="transform:translateZ(60px)">
              <span class="text-emerald-300">NF-e</span> emitida com sucesso
            </div>
            <div class="absolute -bottom-5 -left-6 rounded-2xl border border-white/15 bg-[#0b0d1c]/90 px-4 py-3 text-sm shadow-xl backdrop-blur" style="transform:translateZ(80px)">
              Mensagem enviada no <span class="text-sky-300">WhatsApp</span>
            </div>
          </div>
        </div>
      </div>

      <a href="#numeros" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-white/40 transition hover:text-white lg:block" aria-label="Rolar para baixo">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
      </a>
    </section>

    <!-- FAIXA -->
    <div class="overflow-hidden border-y border-white/10 bg-white/[0.02] py-5" aria-hidden="true">
      <div class="faixa-rolante flex w-max gap-12 whitespace-nowrap">
        {[...faixa, ...faixa].map((t) => (<span class="font-display text-lg text-white/40">{t} <span class="ml-12 text-blue-400/60">✦</span></span>))}
      </div>
    </div>

    <!-- NÚMEROS -->
    <section id="numeros" class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {numeros.map((n, i) => (
          <div class="cartao revelar p-8 text-center" style={`--atraso:${i * 90}ms`}>
            <p class="font-display text-5xl font-bold">
              <span class="texto-gradiente contador" data-alvo={n.valor}>0</span><span class="texto-gradiente">{n.sufixo}</span>
            </p>
            <p class="mt-3 text-sm text-white/55">{n.rotulo}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- SISTEMAS -->
    <section id="sistemas" class="mx-auto max-w-7xl scroll-mt-20 px-5 pb-28 sm:px-8">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="revelar text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Nossos sistemas</p>
        <h2 class="revelar mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl" style="--atraso:80ms">Uma solução para cada <span class="texto-gradiente">tipo de negócio</span></h2>
        <p class="revelar mt-5 text-white/60" style="--atraso:140ms">Plataformas completas, em constante evolução e com suporte de quem desenvolve.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {sistemas.map((s, i) => (
          <article class={`cartao revelar group flex flex-col p-8 ${s.grande ? 'lg:col-span-2 lg:row-span-2' : ''}`} style={`--atraso:${i * 90}ms`}>
            <div class="flex items-start justify-between">
              {s.imagem ? (
                <img src={s.imagem} alt={`Ícone do ${s.nome}`} width="64" height="64" class="h-16 w-16 rounded-2xl object-cover" loading="lazy" />
              ) : (
                <div class={`grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br ${s.cor}`}>
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#05060f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icones[s.icone as string]}></path></svg>
                </div>
              )}
              <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">{s.status}</span>
            </div>
            <p class="mt-8 text-xs font-semibold uppercase tracking-[0.18em] text-white/40">{s.categoria}</p>
            <h3 class={`mt-2 font-display font-bold tracking-tight ${s.grande ? 'text-5xl' : 'text-2xl'}`}>{s.nome}</h3>
            <p class={`mt-4 leading-relaxed text-white/60 ${s.grande ? 'max-w-xl text-lg' : ''}`}>{s.resumo}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.destaques.map((d) => (<li class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/65">{d}</li>))}
            </ul>
            <a href={`https://wa.me/${marca.whatsapp}?text=${encodeURIComponent('Olá! Quero conhecer o ' + s.nome + '.')}`} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-sky-300 transition group-hover:gap-3">
              Quero conhecer
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section id="como-funciona" class="relative scroll-mt-20 border-y border-white/10 bg-white/[0.02] py-28">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="mx-auto mb-16 max-w-2xl text-center">
          <p class="revelar text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Como funciona</p>
          <h2 class="revelar mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl" style="--atraso:80ms">Da conversa ao <span class="texto-gradiente">decolar</span>, em 3 passos</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {passos.map((p, i) => (
            <div class="cartao revelar p-8" style={`--atraso:${i * 110}ms`}>
              <p class="font-display text-6xl font-bold text-white/10">{p.n}</p>
              <h3 class="mt-4 font-display text-2xl font-semibold">{p.titulo}</h3>
              <p class="mt-3 leading-relaxed text-white/60">{p.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PARCEIROS -->
    <section id="parceiros" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-28 sm:px-8">
      <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-blue-600/20 via-[#0b0d1c] to-violet-600/20 p-8 sm:p-14">
        <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-violet-500/30 blur-[100px]" aria-hidden="true"></div>
        <div class="relative grid items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="revelar text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Programa de parceiros</p>
            <h2 class="revelar mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl" style="--atraso:80ms">Indique e <span class="texto-gradiente">ganhe comissão</span></h2>
            <p class="revelar mt-5 max-w-lg text-lg leading-relaxed text-white/65" style="--atraso:140ms">
              Conhece comerciantes que precisam de um sistema? Torne-se parceiro, indique e receba por cada cliente que fechar.
            </p>
            <a href={zapParceiro} target="_blank" rel="noopener" class="botao botao-principal revelar mt-9" style="--atraso:200ms">Quero ser parceiro</a>
          </div>
          <ul class="space-y-4">
            {beneficiosParceiro.map((b, i) => (
              <li class="revelar flex gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur" style={`--atraso:${i * 100}ms`}>
                <span class="mt-1 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-cyan-400 to-blue-600">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg>
                </span>
                <div><h3 class="font-display text-lg font-semibold">{b.titulo}</h3><p class="mt-1 text-sm leading-relaxed text-white/60">{b.texto}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- CONTATO -->
    <section id="contato" class="relative scroll-mt-20 overflow-hidden px-5 pb-28 sm:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="revelar font-display text-4xl font-bold tracking-tight sm:text-6xl">Pronto para <span class="texto-gradiente">decolar?</span></h2>
        <p class="revelar mx-auto mt-6 max-w-xl text-lg text-white/60" style="--atraso:100ms">Fale com a gente agora e descubra o sistema certo para o seu negócio.</p>
        <div class="revelar mt-10 flex flex-wrap justify-center gap-4" style="--atraso:180ms">
          <a href={zap} target="_blank" rel="noopener" class="botao botao-principal">Chamar no WhatsApp</a>
          <a href={`mailto:${marca.email}`} class="botao botao-vidro">{marca.email}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 py-10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 text-sm text-white/45 sm:flex-row sm:px-8">
      <div class="flex items-center gap-2.5"><img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7" /><span class="font-display text-white/80">Órbita Soft</span></div>
      <p>© {ano} Órbita Soft. Todos os direitos reservados.</p>
      <p>{marca.dominio}</p>
    </div>
  </footer>

  <!-- Botão flutuante WhatsApp -->
  <a href={zap} target="_blank" rel="noopener" aria-label="Falar no WhatsApp" class="fixed bottom-5 right-5 z-50 grid h-14 w-14 place-items-center rounded-full bg-emerald-500 shadow-lg shadow-emerald-900/50 transition hover:scale-110">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.8-.1 1.4Z"></path></svg>
  </a>

  <script>
    const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Menu mobile
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu-mobile');
    btn?.addEventListener('click', () => {
      const aberto = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(aberto));
    });
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));

    // Cabeçalho com fundo ao rolar
    const topo = document.getElementById('topo');
    const ajustaTopo = () => {
      const rolou = window.scrollY > 20;
      topo?.classList.toggle('bg-[#05060f]/80', rolou);
      topo?.classList.toggle('backdrop-blur-xl', rolou);
      topo?.classList.toggle('border-b', rolou);
      topo?.classList.toggle('border-white/10', rolou);
    };
    ajustaTopo();
    window.addEventListener('scroll', ajustaTopo, { passive: true });

    // Revelar ao rolar + contadores
    const contar = (el: HTMLElement) => {
      const alvo = Number(el.dataset.alvo || 0);
      if (reduzir) { el.textContent = String(alvo); return; }
      const dur = 1600;
      const ini = performance.now();
      const passo = (t: number) => {
        const p = Math.min((t - ini) / dur, 1);
        el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const io = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('visivel');
        e.target.querySelectorAll<HTMLElement>('.contador').forEach(contar);
        io.unobserve(e.target);
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.revelar').forEach((el) => io.observe(el));

    // Brilho do cartão que segue o mouse
    document.querySelectorAll<HTMLElement>('.cartao').forEach((c) => {
      c.addEventListener('pointermove', (ev) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--mx', `${ev.clientX - r.left}px`);
        c.style.setProperty('--my', `${ev.clientY - r.top}px`);
      });
    });

    // Inclinação 3D do mockup
    const tilt = document.getElementById('tilt');
    if (tilt && !reduzir && window.matchMedia('(pointer: fine)').matches) {
      window.addEventListener('pointermove', (ev) => {
        const x = (ev.clientX / window.innerWidth - 0.5) * 2;
        const y = (ev.clientY / window.innerHeight - 0.5) * 2;
        tilt.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 6}deg)`;
      });
    }

    // Órbitas animadas no fundo do hero
    const canvas = document.getElementById('orbitas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (canvas && ctx) {
      let w = 0, h = 0, dpr = 1;
      const anéis = [
        { rx: 0.55, ry: 0.2, rot: -0.45, vel: 0.00020, cor: '103,232,249', n: 3 },
        { rx: 0.75, ry: 0.28, rot: -0.45, vel: -0.00013, cor: '96,165,250', n: 4 },
        { rx: 0.98, ry: 0.36, rot: -0.45, vel: 0.00009, cor: '167,139,250', n: 5 },
      ];
      const estrelas = Array.from({ length: 90 }, () => ({ x: Math.random(), y: Math.random(), r: Math.random() * 1.3 + 0.2, f: Math.random() * 6 }));
      const medir = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = canvas.clientWidth; h = canvas.clientHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      medir();
      window.addEventListener('resize', medir);
      const desenhar = (t: number) => {
        ctx.clearRect(0, 0, w, h);
        for (const s of estrelas) {
          ctx.globalAlpha = 0.25 + 0.35 * Math.abs(Math.sin(t / 1400 + s.f));
          ctx.fillStyle = '#fff';
          ctx.beginPath(); ctx.arc(s.x * w, s.y * h, s.r, 0, 6.283); ctx.fill();
        }
        const cx = w * (w > 1024 ? 0.62 : 0.5), cy = h * 0.5, base = Math.max(w, h) * 0.5;
        for (const a of anéis) {
          ctx.save();
          ctx.translate(cx, cy); ctx.rotate(a.rot);
          ctx.globalAlpha = 0.18;
          ctx.strokeStyle = `rgb(${a.cor})`; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.ellipse(0, 0, base * a.rx, base * a.ry, 0, 0, 6.283); ctx.stroke();
